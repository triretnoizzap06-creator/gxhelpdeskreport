{
  "builds": [
    {
      "src": "report.js",
      "use": "@vercel/node"
    },
    {
      "src": "health.js",
      "use": "@vercel/node"
    },
    {
      "src": "perf.js",
      "use": "@vercel/node"
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "config.js",
      "use": "@vercel/static"
    },
    {
      "src": "*.png",
      "use": "@vercel/static"
    },
    {
      "src": "*.jpg",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "same-origin"
      },
      "continue": true
    },
    {
      "src": "/api/report/?",
      "dest": "/report.js"
    },
    {
      "src": "/api/health/?",
      "dest": "/health.js"
    },
    {
      "src": "/api/perf/?",
      "dest": "/perf.js"
    },
    {
      "src": "/helpdesk-report/?",
      "dest": "/helpdesk-report.html"
    },
    {
      "src": "/helpdesk-performance/?",
      "dest": "/helpdesk-performance.html"
    },
    {
      "src": "/",
      "dest": "/index.html"
    }
  ]
}
