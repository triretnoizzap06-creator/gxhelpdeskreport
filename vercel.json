{
  "builds": [
    {
      "src": "report.js",
      "use": "@vercel/node"
    },
    {
      "src": "health.js",
      "use": "@vercel/node"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "config.js",
      "use": "@vercel/static"
    },
    {
      "src": "*.png",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "same-origin"
      },
      "continue": true
    },
    {
      "src": "/api/report/?",
      "dest": "/report.js"
    },
    {
      "src": "/api/health/?",
      "dest": "/health.js"
    },
    {
      "src": "/",
      "dest": "/index.html"
    }
  ]
}
